{
  "expo": {
    "name": "Smart Transit",
    "slug": "smart-transportation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smarttransportation",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.marowael.smarttransit",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.marowael.smarttransit",
      "adaptiveIcon": {
        "backgroundColor": "#0B4F8A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4F8A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Smart Transportation to use your camera to scan passenger QR tickets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "756cd773-0825-43d8-830a-db60c1a2bc8e"
      }
    },
    "owner": "marowael"
  }
}
