# ---------------------------------------------------------------
# Smart Transportation Backend — Environment Variables
# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to version control (it is gitignored).
# ---------------------------------------------------------------

# Node.js
NODE_ENV=development
PORT=5000

# Neon PostgreSQL
# DATABASE_URL: pooled connection string (application runtime, serverless-safe)
# DIRECT_URL:   direct connection string (Prisma migrations / DDL)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend (CORS origin)
FRONTEND_URL=http://localhost:8081

# Optional admin seed credentials (used only by prisma/seed.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-8-chars
