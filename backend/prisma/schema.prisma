// Smart Transportation - Prisma Schema (initial, infrastructure phase)
// No business tables are defined yet. The full database schema will be
// designed in the next development phase.
//
// Connection:
//   DATABASE_URL -> Neon pooled connection string (app runtime)
//   DIRECT_URL   -> Neon direct connection string (migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PASSENGER
  STATION_EMPLOYEE
  ADMIN
}

enum TransportType {
  METRO
  BUS
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  passwordHash String
  role      Role     @default(PASSENGER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model MetroLine {
  id           String             @id @default(uuid())
  number       Int                @unique
  nameEn       String
  color        String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lineStations MetroLineStation[]
}

model Station {
  id           String             @id @default(uuid())
  nameEn       String             @unique
  lat          Float
  lng          Float
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lineStations MetroLineStation[]
}

model MetroLineStation {
  lineId    String
  stationId String
  order     Int
  branch    String?

  line    MetroLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([lineId, stationId])
  @@unique([lineId, order])
  @@index([lineId])
  @@index([stationId])
  @@index([lineId, branch])
}

model BusRoute {
  id         String         @id @default(uuid())
  code       String         @unique
  nameEn     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  routeStops BusRouteStop[]
}

model BusStop {
  id         String         @id @default(uuid())
  nameEn     String
  lat        Float
  lng        Float
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  routeStops BusRouteStop[]
}

model BusRouteStop {
  routeId String
  stopId  String
  order   Int

  route BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  BusStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@id([routeId, stopId])
  @@unique([routeId, order])
  @@index([routeId])
  @@index([stopId])
}

model FareRule {
  id            String        @id @default(uuid())
  transportType TransportType
  minStops      Int
  maxStops      Int
  price         Float
  currency      String        @default("EGP")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([transportType, minStops, maxStops])
  @@index([transportType, isActive])
}
