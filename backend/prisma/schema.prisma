// Smart Transportation - Prisma Schema (initial, infrastructure phase)
// No business tables are defined yet. The full database schema will be
// designed in the next development phase.
//
// Connection:
//   DATABASE_URL -> Neon pooled connection string (app runtime)
//   DIRECT_URL   -> Neon direct connection string (migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PASSENGER
  STATION_EMPLOYEE
  ADMIN
}

enum TransportType {
  METRO
  BUS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TicketStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum ValidationResult {
  VALID
  ALREADY_USED
  EXPIRED
  INVALID
}

model User {
  id           String             @id @default(uuid())
  fullName     String
  email        String             @unique
  passwordHash String
  role         Role               @default(PASSENGER)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  bookings     Booking[]
  validations  TicketValidation[]

  @@index([role])
}

model MetroLine {
  id           String             @id @default(uuid())
  number       Int                @unique
  nameEn       String
  color        String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lineStations MetroLineStation[]
}

model Station {
  id                  String             @id @default(uuid())
  nameEn              String             @unique
  lat                 Float
  lng                 Float
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lineStations        MetroLineStation[]
  originBookings      Booking[]          @relation("MetroOriginStation")
  destinationBookings Booking[]          @relation("MetroDestinationStation")
}

model MetroLineStation {
  lineId    String
  stationId String
  order     Int
  branch    String?

  line    MetroLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([lineId, stationId])
  @@unique([lineId, order])
  @@index([lineId])
  @@index([stationId])
  @@index([lineId, branch])
}

model BusRoute {
  id         String         @id @default(uuid())
  code       String         @unique
  nameEn     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  routeStops BusRouteStop[]
  bookings   Booking[]
}

model BusStop {
  id                  String         @id @default(uuid())
  nameEn              String
  lat                 Float
  lng                 Float
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  routeStops          BusRouteStop[]
  originBookings      Booking[]      @relation("BusOriginStop")
  destinationBookings Booking[]      @relation("BusDestinationStop")
}

model BusRouteStop {
  routeId String
  stopId  String
  order   Int

  route BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  BusStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@id([routeId, stopId])
  @@unique([routeId, order])
  @@index([routeId])
  @@index([stopId])
}

model FareRule {
  id            String        @id @default(uuid())
  transportType TransportType
  minStops      Int
  maxStops      Int
  price         Float
  currency      String        @default("EGP")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookings      Booking[]

  @@unique([transportType, minStops, maxStops])
  @@index([transportType, isActive])
}

model Booking {
  id                   String        @id @default(uuid())
  userId               String
  transportType        TransportType
  originStationId      String?
  destinationStationId String?
  busRouteId           String?
  originStopId         String?
  destinationStopId    String?
  fareRuleId           String
  stopCount            Int
  distanceKm           Float?
  totalAmount          Float
  currency             String        @default("EGP")
  status               BookingStatus @default(PENDING)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  originStation      Station?  @relation("MetroOriginStation", fields: [originStationId], references: [id])
  destinationStation Station?  @relation("MetroDestinationStation", fields: [destinationStationId], references: [id])
  busRoute           BusRoute? @relation(fields: [busRouteId], references: [id])
  originStop         BusStop?  @relation("BusOriginStop", fields: [originStopId], references: [id])
  destinationStop    BusStop?  @relation("BusDestinationStop", fields: [destinationStopId], references: [id])
  fareRule           FareRule  @relation(fields: [fareRuleId], references: [id])
  payment            Payment?
  ticket             Ticket?

  @@index([userId, createdAt])
  @@index([status])
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String        @unique
  stripePaymentIntentId String        @unique
  amount                Float
  currency              String        @default("EGP")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Ticket {
  id          String             @id @default(uuid())
  bookingId   String             @unique
  ticketCode  String             @unique
  qrPayload   String             @unique
  status      TicketStatus       @default(ACTIVE)
  issuedAt    DateTime           @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  validations TicketValidation[]

  @@index([status])
}

model TicketValidation {
  id          String           @id @default(uuid())
  ticketId    String?
  employeeId  String
  scannedCode String
  result      ValidationResult
  stationName String?
  notes       String?
  validatedAt DateTime         @default(now())

  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  employee User    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, validatedAt])
  @@index([ticketId, validatedAt])
}
